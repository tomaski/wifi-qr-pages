#!/bin/sh
# Launcher: runs the CLI inside the project-local virtual environment with all
# tool caches redirected into ./.tools (see env.sh). Never modifies the shell.
set -eu

. "$(cd "$(dirname "$0")" && pwd)/env.sh"

[ -x "$VENV_PY" ] || {
    printf '\033[31mError:\033[0m .venv not found. Run ./setup.sh first.\n' >&2
    exit 1
}

# Clear leftovers from any previous run (Chromium scratch profiles, temp html)
rm -rf "$TMPDIR"/* 2>/dev/null || true

export PYTHONPATH="$PROJECT_DIR/src"
cd "$PROJECT_DIR"
exec "$VENV_PY" -m qrpages "$@"
